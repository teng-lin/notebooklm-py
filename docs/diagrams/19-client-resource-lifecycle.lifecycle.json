  "cards": [
    {
      "dot": "emerald",
      "title": "Generations",
      "items": [
        "Each open wave fences SharedRuntime and the selected WebRuntime or AndroidRuntime",
        "A stale Web generation or Android epoch cannot write into a newer generation"
      ]
    },
    {
      "dot": "amber",
      "title": "Drain",
      "items": [
        "CallSupervisor drain waits on operation leases and leaves the generation open",
        "Middleware is not a drain participant; close waves coalesce across caller cancellation"
      ]
    },
    {
      "dot": "rose",
      "title": "Rollback",
      "items": [
        "A failed open runs prepare_close then close_resources on every participant",
        "Rollback failures are logged, never allowed to mask the original open error"
      ]
    }
