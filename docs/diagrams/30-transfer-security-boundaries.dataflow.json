  "flows": [
    {
      "id": "file-policy",
      "from": "localfile",
      "to": "uploadpolicy",
      "label": "admit",
      "classification": "selected backend",
      "variant": "emphasis"
    },
    {
      "id": "policy-upload-creds",
      "from": "uploadpolicy",
      "to": "uploadcreds",
      "label": "validated URL",
      "classification": "credential boundary",
      "variant": "security"
    },
    {
      "id": "upload-transfer",
      "from": "uploadcreds",
      "to": "scotty",
      "label": "authorized bytes",
      "classification": "dedicated client",
      "variant": "emphasis"
    },
    {
      "id": "upload-source",
      "from": "scotty",
      "to": "source",
      "label": "finalize",
      "classification": "server indexes",
      "variant": "dashed"
    },
    {
      "id": "url-policy",
      "from": "asseturl",
      "to": "hoppolicy",
      "label": "enter fence",
      "classification": "neutral guarded plane",
      "labelAt": [
        208,
        428
      ],
      "route": "straight",
      "variant": "security"
    },
    {
      "id": "policy-download-creds",
      "from": "hoppolicy",
      "to": "downloadcreds",
      "label": "await policy",
      "classification": "sticky per URL",
      "labelDy": -23,
      "route": "straight",
      "variant": "security"
    },
    {
      "id": "creds-response",
      "from": "downloadcreds",
      "to": "response",
      "label": "GET",
      "classification": "credential scoped",
      "labelDy": -23,
      "route": "straight"
    },
    {
      "id": "response-verify",
      "from": "response",
      "to": "verify",
      "label": "stream + cleanup",
      "classification": "bounded · exit precise",
      "labelAt": [
        853,
        428
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Neutral download plane",
      "items": [
        "_artifact/_guarded_transfer.py owns redirect, credential, response, and cleanup fencing",
        "WebRuntime or AndroidRuntime supplies the backend credential policy"
      ]
    },
    {
      "dot": "rose",
      "title": "No credential drift",
      "items": [
        "One sticky asynchronous CredentialPolicy is held for each URL chain",
        "Mid-chain 401 or 403 raises AuthError and invalidates the observed bearer generation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cleanup and publication",
      "items": [
        "_await_advisory_cleanup shields response exit, per-URL close, and batch task cleanup",
        "Exit precedence is process exit, pending cancellation, current cancellation, then cleanup cancellation",
        "Verified bytes replace a same-directory staging file only after a complete transfer"
      ]
    }
  ]
}
