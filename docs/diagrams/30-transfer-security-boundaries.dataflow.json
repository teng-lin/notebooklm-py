      "label": "Upload Policy",
      "stage": 1,
      "row": 0,
      "tag": "no redirects"
    },
    {
      "id": "uploadcreds",
      "type": "security",
      "label": "Live Credential",
      "stage": 2,
      "row": 0,
      "tag": "epoch fenced"
