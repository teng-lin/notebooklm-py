  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Backend-selected download planes",
      "items": [
        "Web uses _make_download_client, _redirect_guard, or httpx redirect hooks",
        "Android uses _artifact/_guarded_transfer.py with a sticky bearer policy"
      ]
    },
    {
      "dot": "rose",
      "title": "No credential drift",
      "items": [
        "Both paths validate each redirect before attaching credentials",
        "Android 401 or 403 raises AuthError and invalidates the observed bearer generation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cleanup and publication",
      "items": [
        "Android _await_advisory_cleanup shields response exit, per-URL close, and batch task cleanup",
        "Exit precedence is process exit, pending cancellation, current cancellation, then cleanup cancellation",
        "Single-file downloads replace same-directory staging only after a complete transfer"
      ]
    }
  ]
}
