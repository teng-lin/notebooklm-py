{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Transfer Security Boundaries",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1250,
      540
    ],
    "views": [
      {
        "id": "upload",
        "label": "Source upload",
        "focus": [
          "localfile",
          "uploadpolicy",
          "uploadcreds",
          "scotty",
          "source"
        ],
        "note": "Upload clients are lifecycle-owned, redirect-disabled, and attach live credentials only after validating the server-named session URL."
      },
      {
        "id": "web-download",
        "label": "Web download",
        "focus": [
          "webasseturl",
          "webredirect",
          "webcookies",
          "webresponse",
          "webverify"
        ],
        "note": "Web downloads use _redirect_guard or httpx redirect hooks to revalidate each hop before attaching cookie credentials."
      },
      {
        "id": "android-download",
        "label": "Android download",
        "focus": [
          "asseturl",
          "hoppolicy",
          "downloadcreds",
          "response",
          "verify"
        ],
        "note": "Android guarded_transfer keeps one sticky bearer policy per URL; a mid-chain 401 invalidates the observed generation."
      }
    ]
  },
  "stages": [
