{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Transfer Security Boundaries",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1250,
      540
    ],
    "views": [
      {
        "id": "upload",
        "label": "Source upload",
        "focus": [
          "localfile",
          "uploadpolicy",
          "uploadcreds",
          "scotty",
          "source"
        ],
        "note": "Upload clients are lifecycle-owned, redirect-disabled, and attach live credentials only after validating the server-named session URL."
      },
      {
        "id": "web-download",
        "label": "Web download",
        "focus": [
          "asseturl",
          "hoppolicy",
          "downloadcreds",
          "response",
          "verify"
        ],
        "note": "Neutral guarded transfer keeps one sticky asynchronous CredentialPolicy per URL and revalidates every redirect hop."
      },
      {
        "id": "android-download",
        "label": "Android download",
        "focus": [
          "asseturl",
          "hoppolicy",
          "downloadcreds",
          "response",
          "verify"
        ],
        "note": "A mid-chain 401 raises AuthError and invalidates the observed Android bearer generation inside the per-URL fence."
      }
    ]
  },
  "stages": [
    {
      "label": "Input"
    },
    {
      "label": "Policy"
    },
    {
      "label": "Credential"
    },
    {
      "label": "Transfer"
    },
    {
      "label": "Verify / publish"
    }
  ],
  "nodes": [
    {
      "id": "localfile",
      "type": "frontend",
      "label": "Local File",
      "stage": 0,
      "row": 0
    },
    {
      "id": "uploadpolicy",
