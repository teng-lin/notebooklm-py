      "dot": "violet",
      "title": "Web graph",
      "items": [
        "Web namespaces receive WebRuntime and its executor, kernel, auth and upload collaborators",
        "Positional encoding and strict row decoding remain Web-only; Web stays the compatibility default"
      ]
    },
    {
      "dot": "amber",
      "title": "Android graph",
      "items": [
