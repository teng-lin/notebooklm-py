  "cards": [
    {
      "dot": "cyan",
      "title": "Shared shape",
      "items": [
        "Public namespace classes stay transport-neutral",
        "test_backend_boundaries.py constrains private imports",
        "Typed results are identical whichever backend served the call"
      ]
    },
    {
      "dot": "violet",
      "title": "Web wire",
      "items": [
        "Method IDs in rpc/types.py are the top breakage class",
        "Nested source-id params are position-sensitive",
        "safe_index raises typed shape drift, never raw IndexError"
      ]
    },
    {
      "dot": "amber",
      "title": "Android backend",
      "items": [
        "Needs the android extra: grpcio plus a protobuf runtime",
        "The channel opens lazily and drains with the client",
        "A pinned evidence profile fixes app version and user-agent"
      ]
    }
  ]
