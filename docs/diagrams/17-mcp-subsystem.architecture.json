  "cards": [
    {
      "dot": "cyan",
      "title": "Same cores",
      "items": [
        "Studio generation uses the exact 11-kind request union and one shared validation table",
        "Source batches retain four commit states; inputs and titles are redacted before projection",
        "One long-lived client serves every tool call in the process",
        "MCP owns its wire projection and imports no click, rich, or cli"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety gates",
      "items": [
        "Deletes, user grants/regrades, and public-access widening require confirm=true",
        "Resource previews return canonical parent/target IDs; sharing keeps email/access operands",
        "A separate confirmed call reacquires request access; no lease spans human delay"
      ]
    },
    {
      "dot": "amber",
      "title": "File transfer",
      "items": [
        "Remote FileTransferConfig returns signed links; local configurations retain paths",
        "Remote upload links are single-use; remote downloads remain reusable for Range and resume",
        "notebooklm mcp install wires Claude Desktop, Claude Code, Cursor or Windsurf"
      ]
    }
  ]
