  "cards": [
    {
      "dot": "cyan",
      "title": "Refresh path",
      "items": [
        "Live RPC refreshes coalesce per AuthRefreshCoordinator instance",
        "Cold SingleFlight keys canonical path + rung policy; cancellation spares leader",
        "AuthTokens is mutated in place; collaborators alias it rather than copying"
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery ladder",
      "items": [
        "L2 inline PSIDTS heal runs outside the cold single flight",
        "The installed opt-in L3 rung keeps _auth free of _browser imports",
        "L4 remints from a stored gpsoauth master token"
      ]
    },
    {
      "dot": "rose",
      "title": "Persistence",
      "items": [
        "One path derivation backs all four lock files",
        "credential_io.py is the sole unchecked-atomic writer",
        "Keepalive stamps its claim before the POST, so failure consumes the slot"
      ]
    }
  ]
