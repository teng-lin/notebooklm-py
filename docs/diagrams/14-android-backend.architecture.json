  "cards": [
    {
      "dot": "cyan",
      "title": "Control plane",
      "items": [
        "The channel opens lazily on first use and is fenced to the client resource epoch",
        "Unary and streaming calls carry deadlines and typed gRPC status mapping"
      ]
    },
    {
      "dot": "rose",
      "title": "Identity",
      "items": [
        "The OAuth spec pins the app package, client signature and seven scopes",
        "BearerCredential never exposes its token through repr"
      ]
    },
    {
      "dot": "amber",
      "title": "Data plane",
      "items": [
        "AndroidUploadPipeline and AndroidAssetDownloadService bypass gRPC entirely",
        "Asset hops clear ambient cookies and strip credentials once off the allowlist"
      ]
    }
  ]
