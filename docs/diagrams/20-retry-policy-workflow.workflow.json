    {"id": "classify", "label": "Classify + budget", "fromCol": 2, "toCol": 3, "variant": "emphasis"},
    {"id": "recover", "label": "Dispatch + settle", "fromCol": 4, "toCol": 5, "variant": "dashed"}
  ],
  "mainPath": ["call", "policy", "retry", "dispatch"],
  "nodes": [
    {"id": "call", "lane": "entry", "col": 0, "width": 84, "type": "external", "label": "Operation", "sublabel": "task · epoch"},
    {"id": "dispatch", "lane": "entry", "col": 5, "width": 88, "type": "cloud", "label": "Dispatch", "sublabel": "remaining budget"},
    {"id": "policy", "lane": "entry", "col": 1, "width": 112, "type": "database", "label": "Backend Policy", "sublabel": "Web registry · Android"},
