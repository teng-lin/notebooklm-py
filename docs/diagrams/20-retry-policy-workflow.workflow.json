  "cards": [
    {
      "dot": "cyan",
      "title": "Backend-specific classification",
      "items": [
        "Web uses IdempotencyRegistry; Android uses the total _android/retry_policy.py manifest",
        "Both bound auth, rate-limit, and server recovery by replay safety"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared outcome honesty",
      "items": [
        "idempotent_create probes for a committed result before repeating a create",
        "call_unconfirmed_on_transport_loss and unresolved_commit_error expose unknown commits honestly"
      ]
    },
    {
      "dot": "rose",
      "title": "Secret-safe failure",
      "items": [
        "Ambiguous writes clear traceback frames and suppress cause and context before re-raise",
        "Cancellation and confirmed backend rejections are never relabeled unconfirmed"
      ]
    }
  ]
