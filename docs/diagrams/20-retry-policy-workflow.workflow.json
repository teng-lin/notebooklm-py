      {
        "id": "android",
        "label": "Android retry gate",
        "focus": ["call", "policy", "retry", "dispatch", "idempotency"],
        "note": "The Android manifest is a safe-read ceiling; unknown methods run once and expired calls stop."
      },
      {
        "id": "ambiguity",
        "label": "Mutation evidence",
        "focus": ["policy", "idempotency", "scrub"],
        "note": "Ordered attempts settle into one conservative commit state and a typed recovery action."
