  "cards": [
    {
      "dot": "cyan",
      "title": "Why it exists",
      "items": [
        "Every mutating Web RPC is exposed to a commit-lost failure over HTTPS",
        "Retry safety is a property of the RPC, declared once in the registry"
      ]
    },
    {
      "dot": "emerald",
      "title": "The five policies",
      "items": [
        "IDEMPOTENT_SET_OP and AT_LEAST_ONCE_ACCEPTED keep inner retries on",
        "PROBE_THEN_CREATE and NON_IDEMPOTENT_NO_RETRY force them off"
      ]
    },
    {
      "dot": "rose",
      "title": "Closed axis",
      "items": [
        "UNCLASSIFIED survives only as a placeholder for hand-built test registries",
        "A sixth policy needs an ADR amendment and an executor change in lockstep"
      ]
    }
  ]
