          "resolve",
          "dispatch"
        ],
        "note": "The registry is consulted once per call, before any request is materialised."
      },
      {
        "id": "safe",
        "label": "Retry-safe RPCs",
        "focus": [
          "resolve",
          "idem",
          "atleast"
        ],
        "note": "Replay-safe operations keep the inner retry loop enabled."
      },
      {
        "id": "unsafe",
        "label": "Retry-unsafe RPCs",
        "focus": [
          "resolve",
          "probe",
          "noretry"
        ],
        "note": "Commit-lost failures must surface rather than duplicate a write."
      }
    ]
  },
