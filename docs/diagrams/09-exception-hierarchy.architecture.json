  "cards": [
    {
      "dot": "violet",
      "title": "Direct RPC failures",
      "items": [
        "AuthError, RateLimitError and ServerError directly subclass RPCError",
        "DecodingError and UnknownRPCMethodError remain narrow RPCError types"
      ]
    },
    {
      "dot": "amber",
      "title": "Multiple inheritance",
      "items": [
        "NotebookNotFoundError, SourceNotFoundError and ArtifactNotFoundError share both branches",
        "Callers can catch the domain family or the broader RPC failure family"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two timeout meanings",
      "items": [
        "RPCTimeoutError reports a transport request timeout",
        "ArtifactTimeoutError reports an exhausted local generation wait"
      ]
    }
  ]
