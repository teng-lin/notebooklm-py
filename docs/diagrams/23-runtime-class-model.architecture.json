    {
      "dot": "cyan",
      "title": "Split bundles",
      "items": [
        "RuntimeCollaborators remains only a private alias for neutral SharedRuntime",
        "WebRuntime and AndroidRuntime contain their backend-specific collaborators",
        "Conditional assembly does not construct the unused primary backend runtime"
      ]
    },
    {
      "dot": "violet",
      "title": "Narrowed policy owners",
      "items": [
        "CallSupervisor supplies generation leases and the neutral admission, metrics and semaphore policy",
        "MiddlewareChainHost owns only the Web Retry, AuthRefresh, ErrorInjection and Tracing chain",
        "Transport drain is no longer implemented as middleware"
      ]
    },
    {
      "dot": "rose",
      "title": "Android compatibility",
      "items": [
        "Namespace operation scopes bind an epoch.py session-tagged ContextVar for nested Android calls",
        "LazyWebSidecar is inert until deprecated rpc_call is used on an Android client",
        "A materialised sidecar owns close and reopen but never installs keepalive"
      ]
    }
  ]
